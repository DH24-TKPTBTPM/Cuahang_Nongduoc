<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- [R03] Chuỗi kết nối CSDL – sửa ở đây, KHÔNG sửa trong code.
       CuahangAccess    : file Access cũ (các Factory còn dùng OleDbCommand).
       CuahangSqlServer : SQL Server (các Factory đã chuyển sang SqlCommand – R28).
       Đổi Data Source cho đúng tên instance trên máy mình (xem SQL Server Configuration Manager). -->
  <connectionStrings>
    <add name="CuahangAccess"
         connectionString="Provider=Microsoft.Jet.OLEDB.4.0;Data Source=cuahang.dll;"
         providerName="System.Data.OleDb" />
    <add name="CuahangSqlServer"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=CuahangNongduoc;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
